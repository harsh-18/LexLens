# ==========================================
# LexLens Environment Configuration
# ==========================================

# Google Gemini API Key (Required for AI features)
# Supports Gemini 3.8 Flash for extraction/reasoning and gemini-embedding-001 for embeddings
GOOGLE_API_KEY=

# Optional OpenAI Fallback API Key
OPENAI_API_KEY=

# Storage and Database
DATABASE_URL=sqlite:///./lexlens.db
STORAGE_DIR=./storage

# Security and Authentication
JWT_SECRET=super-secret-lexlens-production-key-change-in-prod-789012345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
